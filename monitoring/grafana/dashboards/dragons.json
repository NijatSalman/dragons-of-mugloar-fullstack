{
  "uid": "dragons-of-mugloar",
  "title": "Dragons of Mugloar",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Games finished",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(mugloar_game_score_count)",
          "legendFormat": "games"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Final score per game (median, 90th percentile, max)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mugloar_game_score{quantile=\"0.5\"}",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "expr": "mugloar_game_score{quantile=\"0.9\"}",
          "legendFormat": "90th percentile"
        },
        {
          "refId": "C",
          "expr": "mugloar_game_score_max",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ads solved per minute: successes vs failures",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (success) (rate(mugloar_ads_solved_total[1m])) * 60",
          "legendFormat": "success={{success}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Success rate per probability label (last 15 min)",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (probability) (increase(mugloar_ads_solved_total{success=\"true\"}[15m])) / sum by (probability) (increase(mugloar_ads_solved_total[15m]))",
          "legendFormat": "{{probability}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Items purchased (last 15 min)",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (item) (increase(mugloar_items_purchased_total{success=\"true\"}[15m]))",
          "legendFormat": "{{item}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Our API: requests per second (TPS) by HTTP status",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Game server: requests per second by endpoint",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_client_requests_seconds_count[1m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Game server: response time (95th percentile and mean)",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_client_requests_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_client_requests_seconds_sum[5m])) / sum(rate(http_client_requests_seconds_count[5m]))",
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rate limiter towards the game server: permits available, threads waiting",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resilience4j_ratelimiter_available_permissions",
          "legendFormat": "permits available"
        },
        {
          "refId": "B",
          "expr": "resilience4j_ratelimiter_waiting_threads",
          "legendFormat": "threads waiting"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "JVM heap memory: used vs maximum",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "maximum"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ]
}
